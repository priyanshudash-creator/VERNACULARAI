# ==========================================
# VernacularAI Environment Configuration
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated)
CLIENT_URL=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/vernacularai
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/vernacularai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vernacularai

# Authentication & JWT Secrets
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend API Base URL (Used by Vite frontend client)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Real AI Translation & Pedagogical Copilot Provider Key (Server-side ONLY)
# Supports Google Gemini API (Recommended: gemini-1.5-flash / gemini-2.0-flash)
# Also supports Google Cloud Translation API or OpenAI
# Note: If left blank, VernacularAI automatically uses its high-accuracy multi-tier
# translation gateway (MyMemory 100+ language API + Indigenous Ol Chiki engine)
TRANSLATION_API_KEY=your_provider_api_key
GEMINI_API_KEY=your_gemini_api_key
